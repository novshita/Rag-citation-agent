# Copy to .env and fill in. Never commit .env.

# Which LLM answers questions: gemini (has a free tier) or anthropic (paid)
LLM_PROVIDER=gemini

# Model id for that provider. For Gemini, copy a current id from https://aistudio.google.com
LLM_MODEL=

# API key for the chosen provider. Put real keys in .env only, never in this file.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Local sentence-transformers embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Number of chunks to retrieve per question
TOP_K=5

# Minimum top similarity score needed to attempt an answer (tune on the dev set)
MIN_SCORE=0.3

# Retries when the model returns invalid structured output
MAX_RETRIES=2

# Chunk size and overlap, in words (~1.3 tokens each). all-MiniLM-L6-v2 reads
# at most 256 tokens per chunk, so keep CHUNK_SIZE around 150 for that model.
CHUNK_SIZE=150
CHUNK_OVERLAP=20

# Where the vector store is saved
CHROMA_DIR=data/chroma

# SQLite file where each query is logged
LOG_DB=data/logs.sqlite

# Optional cross-encoder reranking: fetch RERANK_CANDIDATES passages, rescore, keep TOP_K
RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20

# Optional hybrid search: merge keyword (BM25) matches with the vector matches
HYBRID=false

# API only: if set, POST /ask requires an "X-API-Key: <this value>" header.
# Set this for any deployment reachable from the internet (each request spends LLM quota).
# RAG_API_KEY=
