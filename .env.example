# Copy to .env and fill in. Never commit .env.

# Which LLM answers questions: gemini (has a free tier) or anthropic (paid)
LLM_PROVIDER=gemini

# Model id for that provider. For Gemini, copy a current id from https://aistudio.google.com
LLM_MODEL=

# API key for the chosen provider. Put real keys in .env only, never in this file.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Local sentence-transformers embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Number of chunks to retrieve per question
TOP_K=5

# Minimum top similarity score needed to attempt an answer. 0.42 is what the evaluation used,
# chosen with `python -m rag tune` on the dev questions; retune it for other documents.
MIN_SCORE=0.42

# Retries when the model returns invalid structured output
MAX_RETRIES=2

# Chunk size and overlap, in words (~1.3 tokens each). all-MiniLM-L6-v2 reads
# at most 256 tokens per chunk, so keep CHUNK_SIZE around 150 for that model.
CHUNK_SIZE=150
CHUNK_OVERLAP=20

# Where the vector store is saved
CHROMA_DIR=data/chroma

# SQLite file where each query is logged
LOG_DB=data/logs.sqlite

# Optional cross-encoder reranking: fetch RERANK_CANDIDATES passages, rescore, keep TOP_K
RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20

# Optional hybrid search: merge keyword (BM25) matches with the vector matches
HYBRID=false

# API only: if set, POST /ask requires an "X-API-Key: <this value>" header.
# Set this for any deployment reachable from the internet (each request spends LLM quota).
# RAG_API_KEY=

# Optional web-search fallback for questions the documents can't answer. The answer is
# shown separately and labelled as NOT from your documents. Your question is sent to a
# web search service, so leave this off for private questions. Needs: pip install -e ".[web]"
WEB_FALLBACK=false
WEB_RESULTS=5

# Optional: a JSON file with the name, note and example questions the web UI shows for your documents.
# Defaults to data/raw/CORPUS.json for the default FastAPI index; leave empty for other indexes.
# CORPUS_MANIFEST=

# Accounts and daily limits for the web UI. Visitors sign in, create an account, or continue as a guest.
# SESSION_SECRET signs the session cookie: use a long random value (python -c "import secrets; print(secrets.token_urlsafe(32))").
# If it is empty a random one is used and everyone is signed out whenever the server restarts.
# SESSION_SECRET=
# AUTH_ENABLED=0 runs the app with no login at all (for local use only).
# AUTH_ENABLED=1
# AUTH_DB=data/auth.sqlite
# GUEST_DAILY_LIMIT=5
# USER_DAILY_LIMIT=30
# Set to 1 when the site is served over HTTPS so the cookie is only sent over HTTPS.
# COOKIE_SECURE=0
